    - uses: jdx/mise-action@08ae2a091c038e1e05ec6f5115dc5c69d5a2a6b8
      env:
        RUSTC_WRAPPER: ""
      with:
        install: true
        cache: false
        mise_dir: ${{ env.MISE_DATA_DIR }}
    - name: Cache / Registry
      uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6
      with:
        shared-key: ${{ runner.os }}-registry
        cache-targets: false
        cache-bin: false
        save-if: "false"
    - uses: mozilla-actions/sccache-action@fc920bf0ec8de6ee65d409111f7ec508035751ba
      with:
        version: v0.18.0
    - run: mise run release:publish:dry
    - uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
      if: >-
        (github.ref == 'refs/heads/dev' || github.ref == 'refs/heads/main') &&
        steps.tools.outputs.cache-hit != 'true'
      with:
        path: ${{ env.MISE_DATA_DIR }}
        key: ${{ steps.tools.outputs.cache-primary-key }}
    - run: sccache --show-stats
      if: always()
    if: >-
      github.event_name == 'pull_request' || ((github.event_name == 'push' ||
      github.event_name == 'workflow_dispatch') && (github.ref == 'refs/heads/dev' ||
      startsWith(github.ref, 'refs/heads/release/v')))
    env:
      RUSTC_WRAPPER: sccache
      SCCACHE_GHA_ENABLED: "true"
      SCCACHE_GHA_VERSION: linux
      MISE_ENABLE_TOOLS: python,rust,uv,gh,git-cliff,glab
  publish_release:
    name: Publish / Release
    runs-on:
    - ubuntu-latest
    timeout-minutes: 30
    needs:
    - package_rust
    - source
    - check_python
    - check_rust
    - validate_test_unit_rust
    - build_product_release
    - build_tests_release
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        fetch-depth: 0
    - name: Resolve Mise Directory
      if: runner.os == 'Windows'
      shell: pwsh
      run: |-
        $directory = Join-Path ([System.IO.Path]::GetTempPath()) 'stkr-mise'
        "MISE_DATA_DIR=$directory" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
    - name: Resolve Mise Directory
      if: runner.os != 'Windows'
      shell: bash
      run: printf 'MISE_DATA_DIR=%s/stkr-mise\n' "${TMPDIR:-/tmp}" >> "$GITHUB_ENV"
    - uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
      id: tools
      with:
        path: ${{ env.MISE_DATA_DIR }}
        key: ${{ runner.os }}-${{ runner.arch }}-mise-v2-${{ hashFiles('mise.lock') }}
    - uses: jdx/mise-action@08ae2a091c038e1e05ec6f5115dc5c69d5a2a6b8
      env:
        RUSTC_WRAPPER: ""
      with:
        install: true
        cache: false
        mise_dir: ${{ env.MISE_DATA_DIR }}
    - name: Cache / Registry
      uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6
      with:
        shared-key: ${{ runner.os }}-registry
        cache-targets: false
        cache-bin: false
        save-if: "false"
    - uses: mozilla-actions/sccache-action@fc920bf0ec8de6ee65d409111f7ec508035751ba
      with:
        version: v0.18.0
    - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
      with:
        pattern: package-release-*
        merge-multiple: true
        path: target/ci
    - name: Extract Packages
      shell: bash
      run: for archive in target/ci/*.tar; do tar -xf "$archive"; done
    - id: crates
      uses: rust-lang/crates-io-auth-action@v1
    - run: mise run release:publish
      env:
        GH_TOKEN: ${{ github.token }}
        CARGO_REGISTRY_TOKEN: ${{ steps.crates.outputs.token }}
    - uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
      if: >-
        (github.ref == 'refs/heads/dev' || github.ref == 'refs/heads/main') &&
        steps.tools.outputs.cache-hit != 'true'
      with:
        path: ${{ env.MISE_DATA_DIR }}
        key: ${{ steps.tools.outputs.cache-primary-key }}
    - run: sccache --show-stats
      if: always()
    if: >-
      startsWith(github.ref, 'refs/tags/v') && (!startsWith(github.ref,
      'refs/tags/v') || (needs.source.result == 'success' && needs.check_python.result == 'success'
      && needs.check_rust.result == 'success' && needs.validate_test_unit_rust.result
      == 'success' && needs.build_product_release.result == 'success' &&
      needs.build_tests_release.result == 'success'))
    environment: release
    permissions:
      contents: write
      actions: read
      id-token: write
    env:
      RUSTC_WRAPPER: sccache
      SCCACHE_GHA_ENABLED: "true"
      SCCACHE_GHA_VERSION: linux
      MISE_ENABLE_TOOLS: python,rust,uv,gh,git-cliff,glab
  validate_coverage:
    name: Validate / Coverage
    runs-on:
    - self-hosted
    - linux
    timeout-minutes: 180
    needs:
    - build_product_dev
    - build_product_release
    - build_tests_dev
    - build_tests_release
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        fetch-depth: 0
    - name: Resolve Mise Directory
      if: runner.os == 'Windows'
      shell: pwsh
      run: |-
        $directory = Join-Path ([System.IO.Path]::GetTempPath()) 'stkr-mise'
        "MISE_DATA_DIR=$directory" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
    - name: Resolve Mise Directory
      if: runner.os != 'Windows'
      shell: bash
      run: printf 'MISE_DATA_DIR=%s/stkr-mise\n' "${TMPDIR:-/tmp}" >> "$GITHUB_ENV"
    - uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
      id: tools
      with:
        path: ${{ env.MISE_DATA_DIR }}
        key: ${{ runner.os }}-${{ runner.arch }}-mise-v2-${{ hashFiles('mise.lock') }}
    - uses: jdx/mise-action@08ae2a091c038e1e05ec6f5115dc5c69d5a2a6b8
      env:
        RUSTC_WRAPPER: ""
      with:
        install: true
        cache: false
        mise_dir: ${{ env.MISE_DATA_DIR }}
    - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
      with:
        name: >-
          build-product-${{ startsWith(github.ref, 'refs/tags/v') && 'release' || 'dev'
          }}-linux
    - name: Extract Build
      shell: bash
      run: >-
        tar --zstd -xf "build-product-${{ startsWith(github.ref, 'refs/tags/v') &&
        'release' || 'dev' }}-linux.tar.zst"
    - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
      with:
        name: >-
          build-tests-${{ startsWith(github.ref, 'refs/tags/v') && 'release' || 'dev'
          }}-linux
    - name: Extract Build
      shell: bash
      run: >-
        tar --zstd -xf "build-tests-${{ startsWith(github.ref, 'refs/tags/v') &&
        'release' || 'dev' }}-linux.tar.zst"
    - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
      with:
        name: >-
          build-fixtures-${{ startsWith(github.ref, 'refs/tags/v') && 'release' || 'dev'
          }}-linux
    - name: Extract Build
      shell: bash
      run: >-
        tar --zstd -xf "build-fixtures-${{ startsWith(github.ref, 'refs/tags/v') &&
        'release' || 'dev' }}-linux.tar.zst"
    - run: >-
        mise run test:coverage --profile ${{ startsWith(github.ref, 'refs/tags/v') &&
        'release' || 'dev' }}
    - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
      if: always()
      with:
        name: >-
          junit-coverage-${{ startsWith(github.ref, 'refs/tags/v') && 'release' || 'dev'
          }}-linux
        path: >-
          target/tests/${{ startsWith(github.ref, 'refs/tags/v') && 'release' || 'dev'
          }}/*/coverage/
        if-no-files-found: ignore
        retention-days: 7
        include-hidden-files: true
    if: >-
      always() && ((startsWith(github.ref, 'refs/tags/v') &&
      needs.build_product_release.result == 'success' && needs.build_tests_release.result == 'success') ||
      (!startsWith(github.ref, 'refs/tags/v') && needs.build_product_dev.result ==
      'success' && needs.build_tests_dev.result == 'success')) && github.event_name ==
