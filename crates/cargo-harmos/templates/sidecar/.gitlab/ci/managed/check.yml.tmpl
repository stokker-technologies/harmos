Check / Rust (windows):
  stage: Check
  tags:
  - saas-windows-medium-amd64
  timeout: 120 minutes
  needs: []
  script:
  - mise run check:rust
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
  - if: $CI_PIPELINE_SOURCE == "schedule"
  hooks:
    pre_get_sources_script:
    - git config --global core.longpaths true
  inherit:
    default:
    - interruptible
  before_script:
  - >-
    python .gitlab/actions/setup/run.py --platform windows --emit-shell |
    Invoke-Expression
  - mise trust --yes
  - mise install --yes
  variables:
    MISE_ENABLE_TOOLS: >-
      go,python,rust,uv,github:bnjbvr/cargo-machete,aqua:koalaman/shellcheck,go:github.com/rhysd/actionlint/cmd/actionlint,taplo
Review / Release:
  stage: Check
  tags:
  - saas-linux-medium-amd64
  timeout: 120 minutes
  needs: []
  script:
  - python3 .gitlab/actions/review-release/run.py
  rules:
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_TAG =~ /^v[0-9]/
    variables:
      REVIEW_REQUIRED: "true"
  - if: >-
      $CI_PIPELINE_SOURCE == "web" || ($CI_PIPELINE_SOURCE == "push" &&
      $CI_COMMIT_TAG =~ /^v[0-9]/)
  environment:
    name: release
    action: verify
  variables:
    REVIEW_BUILDS: "[]"
    REVIEW_RELEASE: "true"
    REVIEW_PACKAGES: "[\"Package / Rust (unix)\",\"Package / Rust (windows)\"]"
  artifacts:
    expire_in: 7 days
    paths:
    - target/ci/validated.env
    reports:
      dotenv: target/ci/validated.env
  before_script:
  - python3 .gitlab/actions/setup/run.py --platform unix
  - mise trust --yes
  - mise install --yes
  - >-
    provider_environment="$(python3 .gitlab/actions/setup/run.py --glab-version
    1.124.0 --emit-shell)" || exit $?; eval "$provider_environment"
