Package / Rust (linux):
  stage: Package
  tags:
  - saas-linux-medium-amd64
  timeout: 30 minutes
  needs:
  - job: Check / Repository
    artifacts: false
  - job: Check / Rust (linux)
    artifacts: false
  - job: Test / Rust / Unit (linux)
    artifacts: false
  - job: Build / Product (linux)
    artifacts: true
  - job: Validated / Repository
    artifacts: true
    optional: true
  script:
  - tar --zstd -xf "target/ci/build-product-$PROFILE-linux.tar.zst"
  - mise run package:rust --profile $PROFILE
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  artifacts:
    name: package-$PROFILE-rust-linux-*
    expire_in: 7 days
    paths:
    - target/package/$PROFILE/linux-*/rust/
  variables:
    MISE_ENABLE_TOOLS: >-
      python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:rhysd/actionlint,git-cliff
  before_script:
  - >-
    if [ "$CI_PIPELINE_SOURCE" = push ] && { [ "$CI_COMMIT_BRANCH" = dev ] || [ -n
    "$CI_COMMIT_TAG" ]; } && [ "$validated" = true ]; then printf 'Reusing green
    review pipeline %s\n' "$review_run"; exit 0; fi
  - mise trust --yes
  - mise install --yes
  cache:
  - key:
      prefix: stkr-v4-cargo-downloads-linux-$CI_RUNNER_ID
      files:
      - Cargo.lock
    paths:
    - .cache/cargo/registry/
    - .cache/cargo/git/
    policy: $STKR_CACHE_POLICY
  - key:
      prefix: stkr-v4-mise-linux-$CI_RUNNER_ID
      files:
      - mise.lock
    paths:
    - .cache/mise/downloads/
    policy: $STKR_CACHE_POLICY
  - key:
      prefix: stkr-v4-uv-linux-$CI_RUNNER_ID
      files:
      - uv.lock
      - mise.lock
    paths:
    - .cache/uv/
    policy: $STKR_CACHE_POLICY
