Build / Product (linux):
  stage: Build
  tags:
  - saas-linux-medium-amd64
  timeout: 30 minutes
  needs:
  - job: Validated / Repository
    artifacts: true
    optional: true
  script:
  - mise run build --profile $PROFILE
  - |-
    native="$(mise exec -- uv run --locked --project tools/python python -m project_tools.build.paths build --profile $PROFILE)"
    native="${native##*/}"
    mkdir -p target/ci
    candidates=("target/build/$PROFILE/${native}/" "target/build/$PROFILE/any/" "target/generated/")
    outputs=()
    for path in "${candidates[@]}"; do
      if [ -e "$path" ]; then outputs+=("$path"); fi
    done
    [ ${#outputs[@]} -gt 0 ]
    tar --zstd -cf "target/ci/build-product-$PROFILE-linux.tar.zst" --exclude='*/tests' --exclude='*/fixtures' --exclude='*/bench' -- "${outputs[@]}"
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(dev|main)$/
  - if: $CI_PIPELINE_SOURCE == "schedule"
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  artifacts:
    expire_in: 7 days
    paths:
    - target/ci/build-product-$PROFILE-linux.tar.zst
  variables:
    MISE_ENABLE_TOOLS: >-
      python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,github:bnjbvr/cargo-machete,sccache,aqua:rhysd/actionlint,taplo
  before_script:
  - >-
    if [ "$CI_PIPELINE_SOURCE" = push ] && { [ "$CI_COMMIT_BRANCH" = dev ] || [ -n
    "$CI_COMMIT_TAG" ]; } && [ "$validated" = true ]; then printf 'Reusing green
    review pipeline %s\n' "$review_run"; exit 0; fi
  - mise trust --yes
  - mise install --yes
  cache:
  - key:
      prefix: stkr-v4-cargo-downloads-linux-$CI_RUNNER_ID
      files:
      - Cargo.lock
    paths:
    - .cache/cargo/registry/
    - .cache/cargo/git/
    policy: $STKR_CACHE_POLICY
  - key:
      prefix: stkr-v4-mise-linux-$CI_RUNNER_ID
      files:
      - mise.lock
    paths:
    - .cache/mise/downloads/
    policy: $STKR_CACHE_POLICY
  - key:
      prefix: stkr-v4-uv-linux-$CI_RUNNER_ID
      files:
      - uv.lock
      - mise.lock
    paths:
    - .cache/uv/
    policy: $STKR_CACHE_POLICY
