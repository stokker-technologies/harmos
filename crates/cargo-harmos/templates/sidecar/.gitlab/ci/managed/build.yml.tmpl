Build / Product (windows):
  stage: Build
  tags:
  - saas-windows-medium-amd64
  timeout: 30 minutes
  needs:
  - job: Validated / Repository
    artifacts: true
    optional: true
  script:
  - mise run build --profile $env:PROFILE
  - |-
    $native = Split-Path -Leaf (& mise exec -- uv run --locked --project tools/python python -m project_tools.build.paths build --profile $env:PROFILE)
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    New-Item -ItemType Directory -Force target/ci | Out-Null
    [string[]]$outputs = @("target/build/$env:PROFILE/${native}/", "target/build/$env:PROFILE/any/", "target/generated/") | ForEach-Object { Get-Item -Path $_.TrimEnd('/','\') -ErrorAction SilentlyContinue } | ForEach-Object { (Resolve-Path -LiteralPath $_.FullName -Relative).Replace('\', '/') }
    if (!$outputs) { throw 'No build outputs found' }
    & "$env:ProgramFiles\Git\usr\bin\tar.exe" -cf "target/ci/build-product-$env:PROFILE-windows.tar.zst" --force-local --use-compress-program "zstd -T0" --exclude='*/tests' --exclude='*/fixtures' --exclude='*/bench' -- @outputs
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(dev|main)$/
  - if: $CI_PIPELINE_SOURCE == "schedule"
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  artifacts:
    expire_in: 7 days
    paths:
    - target/ci/build-product-$PROFILE-windows.tar.zst
  inherit:
    default:
    - interruptible
  before_script:
  - >-
    if ($env:CI_PIPELINE_SOURCE -eq 'push' -and ($env:CI_COMMIT_BRANCH -eq 'dev'
    -or $env:CI_COMMIT_TAG) -and $env:validated -eq 'true') { Write-Host "Reusing green
    review pipeline $env:review_run"; exit 0 }
  - mise trust --yes
  - mise install --yes
  variables:
    MISE_ENABLE_TOOLS: >-
      python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,github:bnjbvr/cargo-machete,sccache,aqua:rhysd/actionlint,taplo
  cache:
  - key:
      prefix: stkr-v4-cargo-downloads-linux-$CI_RUNNER_ID
      files:
      - Cargo.lock
    paths:
    - .cache/cargo/registry/
    - .cache/cargo/git/
    policy: $STKR_CACHE_POLICY
  - key:
      prefix: stkr-v4-mise-linux-$CI_RUNNER_ID
      files:
      - mise.lock
    paths:
    - .cache/mise/downloads/
    policy: $STKR_CACHE_POLICY
  - key:
      prefix: stkr-v4-uv-linux-$CI_RUNNER_ID
      files:
      - uv.lock
      - mise.lock
    paths:
    - .cache/uv/
    policy: $STKR_CACHE_POLICY
