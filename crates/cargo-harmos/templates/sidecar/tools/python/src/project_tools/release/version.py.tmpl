def _table_keys(header: str) -> list[str]:
    parsed = tomllib.loads(header + "\n__release_pin_marker__ = true")
    keys = []
    while "__release_pin_marker__" not in parsed:
        key = next(iter(parsed))
        keys.append(key)
        parsed = parsed[key]
    return keys


# === Entry Point === #

if __name__ == "__main__":
    raise SystemExit(policy.main("version", ["check", "sync"], run))
