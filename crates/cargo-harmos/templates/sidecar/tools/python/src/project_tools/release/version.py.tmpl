"""Check And Synchronize Declared Static Package Versions"""

# === Imports === #

# Standard Library Imports
import json
import re
import tomllib
from pathlib import Path

# Third Party Imports
# Local Imports
from . import policy

# Type Checking Imports

# === Public Exports === #

# === Constants === #

VERSION = r"[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?"

# === Types === #

# === Classes === #

