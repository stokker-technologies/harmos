def run(
    command: Sequence[str] | str,
    shell: str | None = None,
    *,
    statistics: dict | None = None,
) -> int:
    """Require The Declared Backend And Clean Up Only Our Process."""
    backend = os.environ.get("STKR_SCCACHE_BACKEND")
    environment = {key: value for key, value in os.environ.items() if not key.startswith("SCCACHE_")}
    mode = os.environ.get(
        "STKR_SCCACHE_MODE",
        "READ_WRITE" if os.environ.get("STKR_CACHE_POLICY") == "pull-push" else "READ_ONLY",
    )
    if mode not in {"READ_ONLY", "READ_WRITE"}:
        raise RuntimeError("sccache: invalid backend access mode")
    if backend == "s3":
        if not os.environ.get("STKR_SCCACHE_BUCKET") or not os.environ.get("STKR_SCCACHE_REGION"):
            raise RuntimeError("sccache: S3 bucket and region are required")
        environment.update(
            SCCACHE_BUCKET=os.environ["STKR_SCCACHE_BUCKET"],
            SCCACHE_REGION=os.environ["STKR_SCCACHE_REGION"],
            SCCACHE_S3_RW_MODE=mode,
            SCCACHE_S3_KEY_PREFIX="stkr-v5/" + os.environ.get("CI_PROJECT_PATH_SLUG", "project") + "/",
        )
        if endpoint := os.environ.get("STKR_SCCACHE_ENDPOINT"):
            environment["SCCACHE_ENDPOINT"] = endpoint
    elif backend == "disk":
        if not os.environ.get("STKR_SCCACHE_DIR"):
            raise RuntimeError("sccache: an explicit disk cache directory is required")
        directory = Path(os.environ["STKR_SCCACHE_DIR"])
        directory.mkdir(parents=True, exist_ok=True)
        environment.update(SCCACHE_DIR=str(directory.resolve()), SCCACHE_LOCAL_RW_MODE=mode)
    else:
        raise RuntimeError("sccache: a supported explicit backend is required")
    with tempfile.TemporaryDirectory(prefix="stkr-sccache-") as temporary:
        # Ignore Persistent Runner Configuration And Use Only The Declared Store.
        configuration = Path(temporary) / "config"
        configuration.write_text("", encoding="utf-8")
        environment.update(
            SCCACHE_CONF=str(configuration),
            SCCACHE_CACHED_CONF=str(Path(temporary) / "cached-config"),
        )
        return _execute(command, shell, environment, backend, statistics=statistics)


# === Private Functions === #


def _execute(
    command: Sequence[str] | str,
    shell: str | None,
    environment: dict[str, str],
    backend: str | None = None,
    *,
    statistics: dict | None = None,
) -> int:
    endpoint: queue.Queue[str] = queue.Queue(maxsize=1)
    write_errors = dict.fromkeys(("AlreadyExists", "PermissionDenied", "RateLimited", "Unexpected", "Unknown"), 0)
    samples: dict[str, str] = {}
    tail: collections.deque[str] = collections.deque(maxlen=TAIL)
    # Native Debug Re-Runs (RUNNER_DEBUG) Or The Explicit Switch Add The Arguments Of Every Missed Compilation.
    diagnostics = "1" in (os.environ.get("STKR_SCCACHE_DIAGNOSTICS"), os.environ.get("RUNNER_DEBUG"))
    keys: dict[str, str] = {}
    arguments: dict[str, str] = {}
    server_environment = environment | {
        "SCCACHE_START_SERVER": "1",
        "SCCACHE_NO_DAEMON": "1",
        "SCCACHE_SERVER_PORT": "0",
        "SCCACHE_LOG": "warn,sccache::server=debug,sccache::compiler::compiler=debug",
        "SCCACHE_IDLE_TIMEOUT": "0",
    }
    # The Server Logs Its Port Only After Backend Readiness And Binding Port 0.
    with subprocess.Popen(
        ["sccache"],
        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        env=server_environment,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        encoding="utf-8",
        errors="replace",
    ) as server:

        def read_endpoint() -> None:
            assert server.stderr is not None
            for line in server.stderr:
                if category := _write_error(line):
                    write_errors[category] += 1
                    samples.setdefault(category, line.partition("Error executing cache write: ")[2].strip()[:300])
                match = re.search(r"server started, listening on 127\.0\.0\.1:([1-9][0-9]*)\s*$", line)
                if match and endpoint.empty():
                    endpoint.put(match[1])
                if re.search(r"\b(WARN|ERROR)\b", line[:80]):
                    tail.append(line.rstrip())
                # Each Miss Prints Its Output And Hash Key, So Keys That Change Between Runs Of One Tree Are Visible.
                compilation = re.search(r"\[([^\]]+)\]: (Hash key: (\S+)|get_cached_or_compile: (.*)|Cache (miss|hit|none) in )", line)
                if compilation is None:
                    continue
                output, key, command, outcome = compilation[1], compilation[3], compilation[4], compilation[5]
                if key:
                    keys[output] = key
                elif command:
                    arguments[output] = command.rstrip()
                else:
                    key, command = keys.pop(output, "unavailable"), arguments.pop(output, "unavailable")
                    if outcome == "miss":
                        print(f"sccache miss: {output} key={key}", flush=True)
                        if diagnostics:
                            print("sccache miss arguments: " + _redact(command), flush=True)
            if endpoint.empty():
                endpoint.put("")

        reader = threading.Thread(target=read_endpoint, daemon=True)
        reader.start()
        try:
            try:
                port = endpoint.get(timeout=60)
            except queue.Empty:
                _report("server startup", ["sccache"], None, tail)
                raise RuntimeError("sccache: backend readiness timed out; check the declared storage access") from None
            if not port or server.poll() is not None:
                reader.join(timeout=1)
                _report("server startup", ["sccache"], server.poll(), tail)
                raise RuntimeError("sccache: backend startup failed; check the declared storage access")
            child_environment = environment | {
                "SCCACHE_SERVER_PORT": port,
                "RUSTC_WRAPPER": "sccache",
                "CARGO_INCREMENTAL": "0",
            }
            if os.name == "nt":
                # MSVC link.exe Stamps Each Proc-Macro DLL With A Fresh Timestamp And PDB GUID; Every Crate Hashing That DLL As
                # An --extern Input Then Misses. /Brepro Makes The Link Output Content-Derived. LINK Is Not A Hashed Input.
                child_environment["LINK"] = " ".join(filter(None, ("/Brepro", environment.get("LINK"))))
            if backend is not None:
                readiness = None
                verification = ["sccache", "--show-stats", "--stats-format", "json"]
                try:
                    readiness = subprocess.run(
                        verification,
                        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
                        env=child_environment,
                        capture_output=True,
                        text=True,
                        check=True,
                        timeout=10,
                    )
                    information = json.loads(readiness.stdout)
                    scheme = "Local disk:" if backend == "disk" else "s3,"
                    if not information.get("cache_location", "").startswith(scheme):
                        raise ValueError(f"unexpected cache location scheme; expected {scheme.rstrip(',:')}")
                    if not str(information.get("version", "")).startswith(SERIES):
                        raise ValueError(f"unsupported version {information.get('version')!r}; expected {SERIES}x")
                except (OSError, ValueError, subprocess.SubprocessError) as error:
                    output = error if isinstance(error, subprocess.CalledProcessError) else readiness
                    _report("backend verification", verification, getattr(output, "returncode", None), tail, error, output)
                    raise RuntimeError("sccache: pinned backend verification failed; refusing implicit storage fallback") from None
            if isinstance(command, str):
                shell = shell or ("pwsh" if os.name == "nt" else "bash")
                command = (
                    [
                        "pwsh",
                        "-NoProfile",
                        "-NonInteractive",
                        "-Command",
                        "$ErrorActionPreference = 'Stop'\n" + command + "\nexit $LASTEXITCODE",
                    ]
                    if shell == "pwsh"
                    else [
                        "bash",
                        "--noprofile",
                        "--norc",
                        "-e",
                        "-o",
                        "pipefail",
                        "-c",
                        command,
                    ]
                )
            with subprocess.Popen(
                command,
                stdin=sys.stdin,
                stdout=sys.stdout,
                stderr=sys.stderr,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
                env=child_environment,
            ) as child:
                try:
                    while child.poll() is None:
                        if server.poll() is not None:
                            child.terminate()
                            reader.join(timeout=1)
                            _report("server", ["sccache"], server.poll(), tail)
                            raise RuntimeError("sccache: owned compiler cache server exited during the command")
                        try:
                            return child.wait(timeout=0.2)
                        except subprocess.TimeoutExpired:
                            continue
                    return child.returncode
                finally:
                    if server.poll() is None:
                        try:
                            result = subprocess.run(
                                ["sccache", "--show-stats", "--stats-format", "json"],
                                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
                                env=child_environment,
                                stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL,
                                text=True,
                                check=True,
                                timeout=10,
                            )
                            if statistics is not None:
                                statistics.update(_statistics(json.loads(result.stdout)))
                        except (
                            OSError,
                            ValueError,
                            TypeError,
                            subprocess.SubprocessError,
                        ):
                            pass
        finally:
            # The Process Handle Is Ours; Never Issue Stop-Server Against A Reused Endpoint.
            if server.poll() is None:
                server.terminate()
            try:
                server.wait(timeout=10)
            except subprocess.TimeoutExpired:
                server.kill()
                server.wait(timeout=10)
            reader.join(timeout=1)
            # One Redacted Native Reason Per Category Makes Dropped Cache Writes Actionable.
            for category, sample in samples.items():
                print(f"sccache write errors: {category} x{write_errors[category]}: {_redact(sample)}", flush=True)
            if statistics is not None:
                statistics.update({f"write_error_{category}": count for category, count in write_errors.items()})


def _report(
    stage: str,
    command: Sequence[str],
    status: int | None,
    tail: Sequence[str],
    error: BaseException | None = None,
    output: object = None,
) -> None:
    """Print The Failed Native Command, Its Tool Version And Redacted Native Output Beside The Fixed Verdict."""
    try:
        version = subprocess.run(
            ["sccache", "--version"],
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            capture_output=True,
            text=True,
            check=False,
            timeout=10,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        version = "sccache (version unavailable)"
    lines = [f"{version or 'sccache (version unavailable)'}: {stage} failed", f"command: {' '.join(command)}"]
    if status is not None:
        lines.append(f"exit status: {status}")
    if error is not None and not isinstance(error, subprocess.CalledProcessError):
        lines.append(f"error: {type(error).__name__}: {error}")
    for name in ("stdout", "stderr"):
        if text := (getattr(output, name, None) or "").strip():
            lines.append(f"{name}:")
            lines.extend("  " + line for line in text.splitlines()[-TAIL:])
    if tail:
        lines.append("server log:")
        lines.extend("  " + line for line in tail)
    print("\n".join(_redact(line) for line in lines), file=sys.stderr, flush=True)


def _redact(text: str) -> str:
    """Remove Credentials And Backend Endpoints From Native Diagnostics."""
    for name in SECRETS:
        if (value := os.environ.get(name)) and len(value) > 3:
            text = text.replace(value, "***")
    return re.sub(r"\b[a-z][a-z0-9+.-]*://\S+", "<url>", text)


def _write_error(line: str) -> str | None:
    """Classify Native Write Failures Without Exposing Backend URLs Or Credentials."""
    _, marker, reason = line.partition("Error executing cache write: ")
    if not marker:
        return None
    category = re.match(r"(AlreadyExists|PermissionDenied|RateLimited|Unexpected)\b", reason)
    return category[1] if category else "Unknown"


def _statistics(information: dict) -> dict[str, int | None]:
    if not isinstance(information, dict):
        return {}
    stats = information.get("stats", {})
    if not isinstance(stats, dict):
        return {}
    result = {}
    for key in (
        "cache_hits",
        "cache_misses",
        "cache_errors",
        "requests_not_cacheable",
        "cache_read_errors",
        "cache_write_errors",
        "cache_writes",
    ):
        value = stats.get(key)
        if key in {"cache_hits", "cache_misses", "cache_errors"}:
            counts = value.get("counts") if isinstance(value, dict) else None
            value = (
                sum(counts.values())
                if isinstance(counts, dict) and all(type(item) is int and item >= 0 for item in counts.values())
                else None
            )
        result[key] = value if type(value) is int and value >= 0 else None
    return result


