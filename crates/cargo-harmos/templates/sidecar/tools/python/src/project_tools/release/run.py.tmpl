                "prepare",
                "review",
                "dry",
                "crates-dry",
                "rehearse",
                "discard",
                "identity",
                "tag",
                "crates",
                "publish",
                "python",
                "finalize",
                "verify",
                "guard",
                "assets",
            ],
            run,
        )
    )
