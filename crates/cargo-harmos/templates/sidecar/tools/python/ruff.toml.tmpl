# === Formatting === #

# Width 140 matches the project formatters: wide displays are the norm and two files still sit side by side in a
# diff on a 4K display.
line-length = 140
# Templates Are Rendered Before Source Formatting
extend-exclude = ["**/.*/**"]
force-exclude = true
# The package's own pyproject.toml keeps every other setting.
extend = "pyproject.toml"
