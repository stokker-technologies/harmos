stages:
- Check
- Build
- check-generated
- Test
- Bench
- Package
- Release
default:
  image:
    name: >-
      ghcr.io/jdx/mise:2026.10.8-debian@sha256:8cc0b83dd86465df9ae4a813cce9ce24cb0b4f749617c419d3e4beb838b365b1
    entrypoint:
    - ""
  before_script:
  - python3 .gitlab/actions/setup/run.py --platform unix
  - mise trust --yes
  - mise install --yes
  interruptible: true
variables:
  CACHE_POLICY: pull
  GIT_DEPTH: "0"
  GIT_STRATEGY: clone
  MISE_YES: "1"
  MISE_LOCKED: "1"
  MISE_EXPERIMENTAL: "1"
  CARGO_INCREMENTAL: "0"
  MISE_DATA_DIR: $CI_PROJECT_DIR/.cache/mise
  CARGO_HOME: $CI_PROJECT_DIR/.cache/cargo
  MISE_DOWNLOADS_DIR: $CI_PROJECT_DIR/.cache/mise/downloads
  pnpm_config_store_dir: $CI_PROJECT_DIR/.cache/pnpm
  UV_CACHE_DIR: $CI_PROJECT_DIR/.cache/uv
workflow:
  rules:
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_TAG =~ /^v[0-9]/
    variables:
      PROFILE: release
    auto_cancel:
      on_new_commit: none
  - if: $CI_PIPELINE_SOURCE == "web" && $CI_COMMIT_BRANCH == "dev"
    variables:
      PROFILE: release
    auto_cancel:
      on_new_commit: none
  - if: $CI_PIPELINE_SOURCE == "schedule"
    variables:
      PROFILE: release
    auto_cancel:
      on_new_commit: none
  - if: >-
      $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_DRAFT ==
      "true"
    when: never
  - if: >-
      $CI_PIPELINE_SOURCE == "merge_request_event" &&
      $CI_MERGE_REQUEST_SOURCE_BRANCH_NAME =~ /^release\/v/
    variables:
      PROFILE: release
    auto_cancel:
      on_new_commit: interruptible
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    variables:
      PROFILE: dev
    auto_cancel:
      on_new_commit: interruptible
  - if: $CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS && $CI_PIPELINE_SOURCE == "push"
    when: never
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
    variables:
      PROFILE: dev
    auto_cancel:
      on_new_commit: interruptible
include:
- local: .gitlab/ci/managed/check.yml
- local: .gitlab/ci/managed/build.yml
- local: .gitlab/ci/managed/test.yml
- local: .gitlab/ci/managed/package.yml
- local: .gitlab/ci/managed/trusted-cache.yml
  rules:
  - if: >-
      $CI_COMMIT_REF_PROTECTED == "true" && $CI_PIPELINE_SOURCE !=
      "merge_request_event" && ($CI_COMMIT_BRANCH =~ /^(dev|main)$/ || $CI_COMMIT_TAG =~
      /^v[0-9]+\.[0-9]+\.[0-9]+$/)
