stages:
- Check
- Build
- check-generated
- Test
- Bench
- Package
- Release
default:
  image:
    name: >-
      ghcr.io/jdx/mise:2026.10.8-debian@sha256:8cc0b83dd86465df9ae4a813cce9ce24cb0b4f749617c419d3e4beb838b365b1
    entrypoint:
    - ""
  before_script:
  - |-
    set -eu
    # === Setup === #
    native_tools='tar zstd unzip zip'
    case ",${MISE_ENABLE_TOOLS:-rust}," in
        *,rust,*|*,cargo:*)
            native_tools="$native_tools cc c++ make pkg-config"
            compiler=1
            ;;
        *) compiler=0 ;;
    esac
    missing=''
    for tool in $native_tools; do
        if ! command -v "$tool" >/dev/null 2>&1; then missing="$missing $tool"; fi
    done
    case "$(tar --version 2>/dev/null || true)" in
        'tar (GNU tar)'*) ;;
        *) missing="$missing GNU-tar" ;;
    esac
    if [ "$compiler" -eq 1 ] && ! pkg-config --exists openssl 2>/dev/null; then
        missing="$missing openssl-development"
    fi
    install_prerequisites() {
        set -- tar zstd unzip zip
        if command -v apt-get >/dev/null 2>&1; then
            if [ "$compiler" -eq 1 ]; then set -- "$@" build-essential pkg-config libssl-dev; fi
            if [ "$(id -u)" -eq 0 ]; then
                apt-get update
                apt-get install -y --no-install-recommends "$@"
            else
                sudo -n apt-get update
                sudo -n apt-get install -y --no-install-recommends "$@"
            fi
        elif command -v apk >/dev/null 2>&1; then
            if [ "$compiler" -eq 1 ]; then set -- "$@" build-base pkgconf openssl-dev; fi
            if [ "$(id -u)" -eq 0 ]; then apk add --no-cache "$@"
            else sudo -n apk add --no-cache "$@"; fi
        else
            printf 'Missing shared CI prerequisites:%s; provide them through the declared job bootstrap or pinned image.\n' "$missing" >&2
            exit 1
        fi
    }
    if [ -n "$missing" ]; then install_prerequisites; fi
    # === Verification === #
    case "$(tar --version)" in
        'tar (GNU tar)'*) ;;
        *) printf 'GNU tar is required.\n' >&2; exit 1 ;;
    esac
    zstd --version
    # === Entry Point === #
  - mise trust --yes
  - mise install --yes
  interruptible: true
variables:
  STKR_CACHE_POLICY: pull
  GIT_DEPTH: "0"
  GIT_STRATEGY: clone
  MISE_YES: "1"
  MISE_LOCKED: "1"
  MISE_EXPERIMENTAL: "1"
  CARGO_INCREMENTAL: "0"
  MISE_DATA_DIR: $CI_PROJECT_DIR/.cache/mise
  CARGO_HOME: $CI_PROJECT_DIR/.cache/cargo
  MISE_DOWNLOADS_DIR: $CI_PROJECT_DIR/.cache/mise/downloads
  npm_config_store_dir: $CI_PROJECT_DIR/.cache/pnpm
  UV_CACHE_DIR: $CI_PROJECT_DIR/.cache/uv
workflow:
  rules:
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
    variables:
      PROFILE: release
    auto_cancel:
      on_new_commit: none
  - if: "$CI_PIPELINE_SOURCE == \"push\" && $CI_COMMIT_BRANCH == \"dev\" && $CI_COMMIT_TITLE =~ /^chore\\(release\\): prepare v[0-9]+\\.[0-9]+\\.[0-9]+$/"
    variables:
      PROFILE: dev
    auto_cancel:
      on_new_commit: none
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
    variables:
      PROFILE: dev
    auto_cancel:
      on_new_commit: interruptible
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(dev|main)$/
    variables:
      PROFILE: dev
    auto_cancel:
      on_new_commit: none
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    variables:
      PROFILE: dev
    auto_cancel:
      on_new_commit: interruptible
  - if: $CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS && $CI_PIPELINE_SOURCE == "push"
    when: never
  - if: $CI_COMMIT_BRANCH
    variables:
      PROFILE: dev
    auto_cancel:
      on_new_commit: none
include:
- local: .gitlab/ci/managed/check.yml
- local: .gitlab/ci/managed/build.yml
- local: .gitlab/ci/managed/test.yml
- local: .gitlab/ci/managed/package.yml
- local: .gitlab/ci/managed/trusted-cache.yml
  rules:
  - if: >-
      $CI_COMMIT_REF_PROTECTED == "true" && $CI_PIPELINE_SOURCE !=
