# === Formatting === #

# Width 140: wide displays are the norm; at the default 100 a three-parameter async signature breaks into one parameter
# per line, at 140 signatures and most chained expressions stay on one line while two files still sit side by side in a
# diff on a 4K display. Compressed keeps longer parameter lists on as few lines as possible.
max_width = 140
fn_params_layout = "Compressed"
use_small_heuristics = "Max"
# Struct literals wider than 40 characters break one field per line, so a literal reads as a record even under the
# maximum small heuristics.
struct_lit_width = 40
