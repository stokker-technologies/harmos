# === Package === #

[package]
name = "__PACKAGE_NAME__"
version = "0.1.0"
edition = "2024"
rust-version = "1.99"
license = "Apache-2.0"

# === Package Targets === #

[lib]
crate-type = ["cdylib", "rlib"]

# === Features === #

[features]
default = ["runtime"]
runtime = ["harmos/runtime", "dep:harmos-guest"]

# === Dependencies === #

# Harmos Sub-Tables Keep Their Layout When cargo-harmos new Substitutes A Local Path
[dependencies.harmos]
git = "https://github.com/stokker-technologies/harmos"
rev = "__HARMOS_REVISION__"
default-features = false

[dependencies.harmos-guest]
git = "https://github.com/stokker-technologies/harmos"
rev = "__HARMOS_REVISION__"
default-features = false
features = ["derive", "kit"]
optional = true


