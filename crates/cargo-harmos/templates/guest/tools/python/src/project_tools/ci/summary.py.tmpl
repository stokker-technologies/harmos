def duration(seconds: float) -> str:
    hours, remainder = divmod(max(0, seconds), 3600)
    minutes, seconds = divmod(remainder, 60)
    return (f"{int(hours)}h " if hours else "") + (f"{int(minutes)}m " if hours or minutes else "") + f"{seconds:.1f}s"


def rows(elapsed: float | None, statistics: dict | None, phases: dict | None = None, caches: dict | None = None) -> list[tuple[str, str]]:
    selected = [("Time / Total", duration(elapsed))] if elapsed is not None else []
    selected.extend((f"Time / {name}", duration(seconds)) for name, seconds in (phases or {}).items())
    if statistics is not None:
        hits, misses = statistics.get("cache_hits"), statistics.get("cache_misses")
        rate = f"{100 * hits / (hits + misses):.1f}%" if hits is not None and misses is not None and hits + misses else "unavailable"
        selected.append(("Cache / Compiler / Hit Rate", rate))
        for metric, key in [("Hits", "cache_hits"), ("Misses", "cache_misses"), ("Non-Cacheable", "requests_not_cacheable")]:
            value = statistics.get(key)
            selected.append((f"Cache / Compiler / {metric}", str(value) if value is not None else "unavailable"))
        errors = sum(statistics.get(key) or 0 for key in ("cache_errors", "cache_read_errors", "cache_write_errors"))
        if errors:
            selected.append(("Cache / Compiler / Errors", str(errors)))
    for name, metrics in (caches or {}).items():
        selected.extend((f"Cache / {name} / {metric}", str(value)) for metric, value in metrics.items() if value is not None)
    return selected


def render(label: str, elapsed: float | None, statistics: dict | None, *, phases: dict | None = None, caches: dict | None = None) -> None:
    measured = rows(elapsed, statistics, phases, caches)
    print(f"{label}: " + "; ".join(f"{name}={value}" for name, value in measured), flush=True)
    if destination := os.environ.get("GITHUB_STEP_SUMMARY"):
        try:
            with Path(destination).open("a", encoding="utf-8") as stream:
                stream.write(f"## {label}\n\n")
                if statistics is not None:
                    stream.write("Compiler Cache: sccache.\n\n")
                stream.write("| Metric | Value |\n| --- | --- |\n")
                stream.writelines(f"| {name} | {value} |\n" for name, value in measured)
                errors = {key: value for key, value in (statistics or {}).items() if "error" in key and isinstance(value, int) and value}
                if errors:
                    stream.write("\n<details><summary>Cache Diagnostics</summary>\n\n")
                    stream.write("```json\n" + json.dumps(errors, indent=2) + "\n```\n\n</details>\n")
                stream.write("\n")
        except OSError:
            print(f"{label}: summary unavailable", flush=True)


@contextlib.contextmanager
def phase(name: str):
    started = time.monotonic()
    try:
        yield
    finally:
        if destination := os.environ.get("STKR_CI_PHASE_FILE"):
            try:
                with Path(destination).open("a", encoding="utf-8") as stream:
                    stream.write(json.dumps({"name": name, "seconds": time.monotonic() - started}) + "\n")
            except OSError:
                print(f"{name}: phase telemetry unavailable", flush=True)


def phases(path: Path) -> dict[str, float]:
    result = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines() if path.is_file() else []
    except (OSError, UnicodeError):
        print("Phase telemetry unavailable", flush=True)
        return result
    for line in lines:
        try:
            item = json.loads(line)
            name, seconds = item["name"], item["seconds"]
            if not isinstance(name, str) or type(seconds) not in (int, float) or not 0 <= seconds < float("inf"):
                raise ValueError("invalid phase metric")
            result[name] = result.get(name, 0) + seconds
        except (ValueError, TypeError, KeyError):
            print("Phase telemetry record unavailable", flush=True)
    return result


