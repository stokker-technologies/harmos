        tar -cf "target/ci/package-${{ env.PROFILE }}-rust-${{ inputs.platform }}.tar" -- "target/package/${{ env.PROFILE }}/${native}/rust"
      if: inputs.platform != 'windows'
    - name: Archive Package
      shell: pwsh
      run: |-
        $native = Split-Path -Leaf (& mise exec -- uv run --locked --project tools/python python -m project_tools.build.paths package --profile ${{ env.PROFILE }})
