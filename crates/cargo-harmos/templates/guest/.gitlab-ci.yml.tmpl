# Rendered by stkr project update from templates/ci/.gitlab-ci.yml; sha256:20e1085b6f1fdbbaa903c0a6769ce894ea15cc59d9178f951eaa8a95ff5bda93
stages:
- Check
- Build
- Validate
- Bench
- Package
- Publish
default:
  image:
    name: >-
      ghcr.io/jdx/mise:2026.10.8-debian@sha256:8cc0b83dd86465df9ae4a813cce9ce24cb0b4f749617c419d3e4beb838b365b1
    entrypoint:
    - ""
  before_script:
  - mise trust --yes
  - mise install --yes
variables:
  GIT_DEPTH: "0"
  MISE_YES: "1"
  MISE_LOCKED: "1"
  CARGO_INCREMENTAL: "0"
  MISE_DATA_DIR: $CI_PROJECT_DIR/.cache/mise
  CARGO_HOME: $CI_PROJECT_DIR/.cache/cargo
  npm_config_store_dir: $CI_PROJECT_DIR/.cache/pnpm
  UV_CACHE_DIR: $CI_PROJECT_DIR/.cache/uv
workflow:
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS && $CI_PIPELINE_SOURCE == "push"
    when: never
  - if: $CI_COMMIT_BRANCH
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
Check / Repository:
  stage: Check
  tags:
  - saas-linux-medium-amd64
  timeout: 10 minutes
  needs: []
  script:
  - mise run format:toml --check
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: >-
      $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~
      /^(dev|main|release\/v.*)$/
  - if: $CI_PIPELINE_SOURCE == "schedule"
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  cache:
  - key:
      prefix: linux-tools
      files:
      - mise.lock
    paths:
    - .cache/mise/
    policy: pull-push
  - key:
      prefix: linux-cargo
      files:
      - Cargo.lock
    paths:
    - .cache/cargo/registry/
    - .cache/cargo/git/
    policy: pull
  variables:
    MISE_ENABLE_TOOLS: >-
      python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:taiki-e/cargo-llvm-cov,sccache,aqua:rhysd/actionlint,taplo,git-cliff
