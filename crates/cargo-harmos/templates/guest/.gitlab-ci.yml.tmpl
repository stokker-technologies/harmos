Validate / Unit / Rust (linux):
  stage: Validate
  tags:
  - saas-linux-medium-amd64
  timeout: 30 minutes
  needs: []
  script:
  - tar --zstd -xf "target/ci/build-tests-$PROFILE-linux.tar.zst"
  - mise run test:unit:rust --profile $PROFILE
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    needs:
    - job: Build / Tests / Dev (linux)
      artifacts: true
    variables:
      PROFILE: dev
  - if: >-
      $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~
      /^(dev|main|release\/v.*)$/
    needs:
    - job: Build / Tests / Dev (linux)
      artifacts: true
    variables:
      PROFILE: dev
  - if: $CI_PIPELINE_SOURCE == "schedule"
    needs:
    - job: Build / Tests / Dev (linux)
      artifacts: true
    variables:
      PROFILE: dev
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
    needs:
    - job: Build / Tests / Release (linux)
      artifacts: true
    variables:
      PROFILE: release
  artifacts:
    name: reports-$PROFILE-linux-unit-rust
    when: always
    expire_in: 7 days
    paths:
    - target/tests/$PROFILE/linux-*/unit-rust/
    reports:
      junit: target/tests/$PROFILE/linux-*/unit-rust/junit.xml
  cache:
  - key:
      prefix: linux-tools
      files:
      - mise.lock
    paths:
    - .cache/mise/
    policy: pull-push
  - key:
      prefix: linux-cargo
      files:
      - Cargo.lock
    paths:
    - .cache/cargo/registry/
    - .cache/cargo/git/
    policy: pull
  variables:
    MISE_ENABLE_TOOLS: >-
      python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:rhysd/actionlint,git-cliff
