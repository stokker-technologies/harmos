# Rendered by stkr project update from templates/profiles/mise.toml; sha256:65a01a6d1875f631f65b2e0b566def3a7564a5c5b5582ac66f2c9066874f54b6
# === Settings === #

[settings]
lockfile = true

# === Tools === #

[tools]
# Languages And Runtimes
go = "1.27.3"
python = "3.15.0"
rust = { version = "1.99.0", components = "clippy,rustfmt,llvm-tools", profile = "minimal" }

# Package Managers
uv = "0.13.0"

# Rust Toolchain
"aqua:nextest-rs/nextest/cargo-nextest" = "0.9.148"
"aqua:taiki-e/cargo-llvm-cov" = "0.9.1"
"github:bnjbvr/cargo-machete" = "0.9.2"
sccache = "0.19.0"

# Formatting And Linting
"aqua:koalaman/shellcheck" = "0.11.0"
"go:github.com/rhysd/actionlint/cmd/actionlint" = "v1.7.13-0.20260417151945-fd33e9f582a0"
taplo = "0.10.0"

# Release And Signing
gh = "2.102.0"
git-cliff = "2.14.2"
glab = "1.123.0"

# Project Statistics
"aqua:boyter/scc" = "4.1.0"

# === Environment === #

[env]

# === Variables === #

[vars]

# === Prepare === #

[tasks.prepare]
description = "Prepare Tools And Inputs"
run = "uv sync --locked --project tools/python --all-groups"

# === Format === #

[tasks.format]
description = "Format Every Language"
usage = 'flag "--check"'
depends = [
  "format:toml {% if usage.check %}--check{% endif %}",
  "format:rust {% if usage.check %}--check{% endif %}",
  "format:python {% if usage.check %}--check{% endif %}",
]

[tasks."format:python"]
description = "Format Python"
usage = 'flag "--check"'
run = 'uv run --locked --project tools/python ruff format --force-exclude --exclude "**/.stkr/templates/**" "tools/python"{% if usage.check %} --check{% endif %}'

[tasks."format:rust"]
description = "Format Rust"
usage = 'flag "--check"'
run = "cargo fmt --all{% if usage.check %} --check{% endif %}"

[tasks."format:toml"]
description = "Format TOML"
usage = 'flag "--check"'
run = "uv run --locked --project tools/python python -m project_tools.format.toml{% if usage.check %} --check{% endif %}"

# === Lint === #

[tasks.lint]
description = "Lint Every Language"
depends = ["lint:rust", "lint:python"]

[tasks."lint:python"]
description = "Lint Python"
run = [
  'uv run --locked --project tools/python ruff check --force-exclude --exclude "**/.stkr/templates/**" "tools/python"',
  'uv run --locked --project tools/python ty check --exclude "**/.stkr/templates/**" "tools/python"',
]

[tasks."lint:rust"]
description = "Lint Rust"
run = [
  "uv run --locked --project tools/python python -m project_tools.build.cargo -- --locked --workspace --profile dev",
  "uv run --locked --project tools/python python -m project_tools.build.cargo -- --locked --workspace --tests --profile test",
]

# === Check === #

[tasks.check]
description = "Check Every Language And Conventions"
run = [{ task = "check:repository" }, { task = "check:rust" }, { task = "check:python" }]

[tasks."check:python"]
description = "Check Python"
run = [{ task = "format:python --check" }, { task = "lint:python" }]

[tasks."check:repository"]
description = "Check Repository Configuration And Conventions"
run = [{ task = "format:toml --check" }, "uv run --locked --project tools/python python -m project_tools.ci.mise"]

[tasks."check:rust"]
description = "Check Rust"
run = [{ task = "format:rust --check" }, { task = "lint:rust" }, "cargo-machete --skip-target-dir"]

# === Build === #

[tasks.build]
description = "Build Packageable Products"
env.CARGO_INCREMENTAL = "0"
usage = 'flag "--profile <profile>" default="dev"'
run = "uv run --locked --project tools/python python -m project_tools.build.rust --profile {{usage.profile}}"

[tasks."build:rust:compatibility"]
description = "Validate Rust Compatibility"
usage = 'flag "--profile <profile>" default="dev"'
run = [
  "uv run --locked --project tools/python python -m project_tools.build.cargo -- --locked --workspace --profile {{usage.profile}} --all-features",
  "uv run --locked --project tools/python python -m project_tools.build.cargo -- --locked --workspace --profile {{usage.profile}} --no-default-features",
]

[tasks."build:rust:focused"]
description = "Compile An Explicit Local Rust Selection"
run = "uv run --locked --project tools/python python -m project_tools.build.cargo focused"

[tasks."build:rust:tests"]
description = "Build Test Binaries And Fixtures"
usage = 'flag "--profile <profile>" default="dev"'
run = "uv run --locked --project tools/python python -m project_tools.build.cargo archive --profile {{usage.profile}}"

# === Dev === #

# ***
#
# Harmos
#
# SPDX-License-Identifier: Apache-2.0
#
# ***


[tasks.dev]
description = "Watch And Rebuild The Plugin"
run = "cargo harmos guest dev"

# === Test === #

[tasks.test]
description = "Test Every Layer"
env.CARGO_INCREMENTAL = "0"
usage = 'flag "--profile <profile>" default="dev"'
depends = ["test:rust --profile {{usage.profile}}"]

[tasks."test:rust"]
description = "Test Rust"
env.CARGO_INCREMENTAL = "0"
usage = 'flag "--profile <profile>" default="dev"'
depends = ["test:rust:unit --profile {{usage.profile}}"]

[tasks."test:rust:coverage"]
description = "Measure Coverage Over Instrumented Lanes"
env.CARGO_INCREMENTAL = "0"
usage = 'flag "--profile <profile>" default="dev"'
run = "uv run --locked --project tools/python python -m project_tools.test.run coverage --language rust --profile {{usage.profile}}"

[tasks."test:rust:unit"]
description = "Test Unit Rust"
env.CARGO_INCREMENTAL = "0"
usage = 'flag "--profile <profile>" default="dev"'
run = "uv run --locked --project tools/python python -m project_tools.test.run test --profile {{usage.profile}} --category unit --language rust"

# === Bench === #

# === Docs === #

# === Package === #

[tasks.package]
description = "Package Every Language"
usage = 'flag "--profile <profile>" default="dev"'
depends = ["package:rust --profile {{usage.profile}}"]

[tasks."package:rust"]
description = "Package Rust"
usage = """
flag "--profile <profile>" default="dev"
flag "--target <target>" default="native""""
run = "uv run --locked --project tools/python python -m project_tools.package.run rust --profile {{usage.profile}} --target {{usage.target}}"

# === CI === #

[tasks."ci:simulate"]
description = "Simulate The Declared CI Graph Locally"
usage = """
flag "--pipeline <kind>" default=pr
flag "--platform <platform>"
flag "--executor <executor>""""
run = "uv run --locked --project tools/python python -m project_tools.ci.simulate {% if usage.pipeline %}--pipeline {{usage.pipeline}}{% endif %} {% if usage.platform %}--platform {{usage.platform}}{% endif %} {% if usage.executor %}--executor {{usage.executor}}{% endif %}"

# === Release === #

[tasks."release:publish:rust"]
description = "Publish Rust Crates"
run = "uv run --locked --project tools/python python -m project_tools.release.run crates"

# === Clean === #

# === Housekeeping === #

[tasks.housekeeping]
description = "Clean Owned Build Outputs And State"
run = "uv run --locked --project tools/python python -m project_tools.stkr project housekeeping"

[tasks."housekeeping:outdated"]
description = "Report Available Dependency And Tool Updates Without Changing Anything"
run = "mise outdated"

[tasks."housekeeping:stats"]
description = "Count Source Lines"
run = "scc"
