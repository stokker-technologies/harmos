// Greeting Contracts And Their Optional Execution.

#[harmos::operation(resources = [], id = "greeting.greet", response = crate::domain::model::greeting::Greeting, policy = super::POLICY)]
pub struct Greet {
    pub name: String,
}

#[cfg(feature = "runtime")]
mod runtime {

    use super::Greet;
    use crate::domain::model::greeting::Greeting;

    impl harmos::Operation for Greet {
        type Error = std::io::Error;

        async fn run(self, _: harmos::Context<'_, Self>) -> Result<harmos::Response<Greeting>, Self::Error> {
            Ok(Greeting::for_name(&self.name).into())
        }
    }
}
