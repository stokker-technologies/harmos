// Greeting Values And Pure Formatting.


#[harmos::message]
pub struct Greeting {
    pub message: String,
}


impl Greeting {
    pub fn for_name(name: &str) -> Self {
        Self { message: format!("Hello, {name}!") }
    }
}


#[cfg(test)]
mod tests {
    #[test]
    fn greeting_names_the_caller() {
        assert_eq!(super::Greeting::for_name("Ada").message, "Hello, Ada!");
    }
}
