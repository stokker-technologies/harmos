impl harmos_guest::Plugin for Plugin {
    type Config = ();
    type Error = std::io::Error;
    type Context = harmos_guest::Context;
    type Resources = ();
    fn prepare(_: ()) -> Result<Self, Self::Error> {
        Ok(Self { resources: Arc::new(()) })
    }
    fn resources(&self) -> Arc<()> {
        Arc::clone(&self.resources)
    }
    fn bind_operations(&self, table: &mut harmos_guest::operations::WireTable) -> Result<(), harmos_guest::operations::ServingError> {
        table.register(operations::Operations::registration(harmos_guest::Dependencies::new()))
    }
    async fn initialize(&mut self, _: &Self::Context) -> Result<(), Self::Error> {
        Ok(())
    }
    async fn stop(&mut self, _: &Self::Context) -> Result<(), Self::Error> {
        Ok(())
    }
    async fn cleanup(&mut self) -> Result<(), Self::Error> {
        Ok(())
    }
}

