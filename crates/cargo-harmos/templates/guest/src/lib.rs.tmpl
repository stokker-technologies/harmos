// Plugin Composition And Explicit Lifecycle Ownership.

pub mod domain;
pub mod operations;


#[cfg(feature = "runtime")]
harmos::guest::export_plugin!(Plugin, capacity = 4);


#[cfg(feature = "runtime")]
pub struct Plugin;


#[cfg(feature = "runtime")]
impl harmos::builtins::lifecycle::Policy for Plugin {
    const INITIALIZATION_POLICY: harmos::OperationPolicy = operations::POLICY;
    const SHUTDOWN_POLICY: harmos::OperationPolicy = operations::POLICY;
}

#[cfg(feature = "runtime")]
#[harmos::guest(id = "__RUST_MODULE__", requires = ())]
impl harmos::guest::Plugin for Plugin {
    const CATALOGS: &'static [harmos::Catalog] = &[operations::Operations::CATALOG];
}

#[cfg(feature = "runtime")]
impl harmos::Lifecycle for Plugin {
    type Config = ();
    type Error = std::io::Error;
    type Context = harmos::guest::kit::Context;

    async fn prepare(_: (), _: &mut harmos::Setup<Self>) -> Result<Self, Self::Error> {
        Ok(Self)
    }
}
