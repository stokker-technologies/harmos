      $root = Split-Path -Parent (Split-Path -Parent $git.Source)
      $candidates += Join-Path $root 'usr/bin/tar.exe'
    }
    $tar = $null
    foreach ($candidate in @($candidates | Select-Object -Unique)) {
      if (!(Test-Path -LiteralPath $candidate -PathType Leaf)) { continue }
      try {
        $version = & $candidate --version 2>$null
        if ($LASTEXITCODE -ne 0 -or "$version" -notmatch '^tar \(GNU tar\)') { continue }
        $capabilities = & $candidate --help 2>$null
        if ($LASTEXITCODE -ne 0 -or "$capabilities" -notmatch '--force-local' -or "$capabilities" -notmatch '--use-compress-program') { continue }
        $tar = $candidate
        break
      } catch { continue }
    }
    if (!$tar) { throw 'GNU tar with force-local and external-compressor support is required; repair native runner provisioning' }
    $env:PATH = (Split-Path -Parent $tar) + [IO.Path]::PathSeparator + $env:PATH
    & $tar -xf "target/ci/build-tests-$env:PROFILE-windows.tar.zst" --force-local --use-compress-program "zstd -d"
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
  - mise run test:rust:unit --profile $env:PROFILE
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(dev|main)$/
  - if: $CI_PIPELINE_SOURCE == "schedule"
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  artifacts:
