    when: always
    expire_in: 7 days
    paths:
    - target/tests/$PROFILE/windows-*/unit-rust/
    reports:
      junit: target/tests/$PROFILE/windows-*/unit-rust/junit.xml
  inherit:
    default:
    - interruptible
