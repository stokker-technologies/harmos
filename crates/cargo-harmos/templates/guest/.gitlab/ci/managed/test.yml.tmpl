Test / Rust / Unit (linux):
  stage: Test
  tags:
  - saas-linux-medium-amd64
  timeout: 120 minutes
  needs:
  - job: Build / Tests (linux)
    artifacts: true
  - job: Validated / Repository
    artifacts: true
    optional: true
  script:
  - tar --zstd -xf "target/ci/build-tests-$PROFILE-linux.tar.zst"
  - mise run test:rust:unit --profile $PROFILE
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(dev|main)$/
  - if: $CI_PIPELINE_SOURCE == "schedule"
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  artifacts:
    name: reports-$PROFILE-linux-unit-rust
    when: always
    expire_in: 7 days
    paths:
    - target/tests/$PROFILE/linux-*/unit-rust/
    reports:
      junit: target/tests/$PROFILE/linux-*/unit-rust/junit.xml
  variables:
    MISE_ENABLE_TOOLS: >-
      python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:rhysd/actionlint,git-cliff
  before_script:
  - >-
    if [ "$CI_PIPELINE_SOURCE" = push ] && { [ "$CI_COMMIT_BRANCH" = dev ] || [ -n
    "$CI_COMMIT_TAG" ]; } && [ "$validated" = true ]; then printf 'Reusing green
    review pipeline %s\n' "$review_run"; exit 0; fi
  - mise trust --yes
  - mise install --yes
Test / Rust / Unit (windows):
