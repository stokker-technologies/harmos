Package / Rust (unix):
  stage: Package
  tags:
  - saas-linux-medium-amd64
  timeout: 120 minutes
  needs:
  - job: Build / Product (unix)
    artifacts: true
  - job: Check / Repository
    artifacts: false
  - job: Check / Rust (unix)
    artifacts: false
  script:
  - >-
    mise exec -- uv run --locked --project tools/python python -m
    project_tools.ci.artifacts extract --archive target/ci/build-product-$PROFILE-unix.tar.zst
    --profile $PROFILE
  - mise run package:rust --profile $PROFILE
  - >-
    mise exec -- uv run --locked --project tools/python python -m
    project_tools.ci.artifacts pack --archive target/ci/package-$PROFILE-rust-unix.tar.zst --profile
    $PROFILE --paths
    5b227461726765742f7061636b6167652f7b70726f66696c657d2f7b7461726765747d225d
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
  - if: $CI_PIPELINE_SOURCE == "schedule"
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  variables:
    MISE_ENABLE_TOOLS: >-
      go,python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:koalaman/shellcheck,go:github.com/rhysd/actionlint/cmd/actionlint,git-cliff
    MISE_TASK_SKIP: build
  artifacts:
    expire_in: 7 days
    paths:
    - target/ci/package-$PROFILE-rust-unix.tar.zst
Package / Rust (windows):
  stage: Package
  tags:
  - saas-windows-medium-amd64
  timeout: 120 minutes
  needs:
  - job: Build / Product (windows)
    artifacts: true
  - job: Check / Repository
    artifacts: false
  - job: Check / Rust (windows)
    artifacts: false
  script:
  - >-
    mise exec -- uv run --locked --project tools/python python -m
    project_tools.ci.artifacts extract --archive target/ci/build-product-$env:PROFILE-windows.tar.zst
    --profile $env:PROFILE
  - mise run package:rust --profile $env:PROFILE
  - >-
    mise exec -- uv run --locked --project tools/python python -m
    project_tools.ci.artifacts pack --archive target/ci/package-$env:PROFILE-rust-windows.tar.zst
    --profile $env:PROFILE --paths
    5b227461726765742f7061636b6167652f7b70726f66696c657d2f7b7461726765747d225d
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "dev"
  - if: $CI_PIPELINE_SOURCE == "schedule"
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  hooks:
    pre_get_sources_script:
    - git config --global core.longpaths true
  inherit:
    default:
    - interruptible
  before_script:
  - >-
    python .gitlab/actions/setup/run.py --platform windows --emit-shell |
    Invoke-Expression
  - mise trust --yes
  - mise install --yes
  variables:
    MISE_ENABLE_TOOLS: >-
      go,python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,aqua:koalaman/shellcheck,go:github.com/rhysd/actionlint/cmd/actionlint,git-cliff
    MISE_TASK_SKIP: build
  artifacts:
    expire_in: 7 days
    paths:
    - target/ci/package-$PROFILE-rust-windows.tar.zst
