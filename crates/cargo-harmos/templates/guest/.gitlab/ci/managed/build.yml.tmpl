Build / Product (linux):
  stage: Build
  tags:
  - saas-linux-medium-amd64
  timeout: 30 minutes
  needs: []
  script:
  - >-
    mise exec -- uv run --locked --project tools/python python -m
    project_tools.test.prune start
  - mise run build --profile $PROFILE
  - |-
    native="$(mise exec -- uv run --locked --project tools/python python -m project_tools.build.paths build --profile $PROFILE)"
    native="${native##*/}"
    mkdir -p target/ci
    candidates=("target/build/$PROFILE/${native}/" "target/build/$PROFILE/any/" "target/generated/")
    outputs=()
    for path in "${candidates[@]}"; do
      if [ -e "$path" ]; then outputs+=("$path"); fi
    done
    [ ${#outputs[@]} -gt 0 ]
    tar --zstd -cf "target/ci/build-product-$PROFILE-linux.tar.zst" --exclude='*/tests' --exclude='*/fixtures' --exclude='*/bench' -- "${outputs[@]}"
  rules:
  - if: >-
      ($CI_PIPELINE_SOURCE == "merge_request_event") && ($CI_COMMIT_BRANCH == "dev"
      || $CI_COMMIT_BRANCH == "main")
    variables:
      COMPILER_CACHE_POLICY: pull-push
  - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  - if: >-
      ($CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(dev|main)$/) &&
      ($CI_COMMIT_BRANCH == "dev" || $CI_COMMIT_BRANCH == "main")
    variables:
      COMPILER_CACHE_POLICY: pull-push
  - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH =~ /^(dev|main)$/
  - if: >-
      ($CI_PIPELINE_SOURCE == "schedule") && ($CI_COMMIT_BRANCH == "dev" ||
      $CI_COMMIT_BRANCH == "main")
    variables:
      COMPILER_CACHE_POLICY: pull-push
  - if: $CI_PIPELINE_SOURCE == "schedule"
  - if: >-
      ($CI_COMMIT_TAG =~ /^v[0-9]/) && ($CI_COMMIT_BRANCH == "dev" ||
      $CI_COMMIT_BRANCH == "main")
    variables:
      COMPILER_CACHE_POLICY: pull-push
  - if: $CI_COMMIT_TAG =~ /^v[0-9]/
  cache:
  - key:
      prefix: linux-tools
      files:
      - mise.lock
    paths:
    - .cache/mise/
    policy: pull-push
  - key:
      prefix: linux-cargo
      files:
      - Cargo.lock
    paths:
    - .cache/cargo/registry/
    - .cache/cargo/git/
    policy: $COMPILER_CACHE_POLICY
  - key:
      prefix: linux-$CI_JOB_NAME_SLUG-target
      files:
      - Cargo.lock
      - mise.lock
    paths:
    - target/debug/deps/
    - target/debug/build/
    - target/debug/.fingerprint/
    - target/release/deps/
    - target/release/build/
    - target/release/.fingerprint/
    policy: $COMPILER_CACHE_POLICY
  artifacts:
    expire_in: 7 days
    paths:
    - target/ci/build-product-$PROFILE-linux.tar.zst
  after_script:
  - >-
    mise exec -- uv run --locked --project tools/python python -m
    project_tools.test.prune prune
  variables:
    COMPILER_CACHE_POLICY: pull
    MISE_ENABLE_TOOLS: >-
      python,rust,uv,aqua:nextest-rs/nextest/cargo-nextest,sccache,aqua:rhysd/actionlint,taplo
