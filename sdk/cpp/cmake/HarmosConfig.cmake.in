@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nanoarrow 0.7.0 EXACT CONFIG)
find_dependency(nlohmann_json 3.12 CONFIG)

if(NOT TARGET Harmos::Ffi)
    add_library(Harmos::Ffi STATIC IMPORTED)
    set_target_properties(Harmos::Ffi PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@harmos_ffi@CMAKE_STATIC_LIBRARY_SUFFIX@")
    add_library(Harmos::Cpp INTERFACE IMPORTED)
    set_target_properties(Harmos::Cpp PROPERTIES
        INTERFACE_COMPILE_FEATURES cxx_std_20
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
        INTERFACE_LINK_LIBRARIES "Harmos::Ffi;nanoarrow::nanoarrow_static;nlohmann_json::nlohmann_json")
    if(MSVC)
        target_compile_options(Harmos::Cpp INTERFACE /Zc:preprocessor /EHsc)
        target_link_options(Harmos::Cpp INTERFACE /OPT:REF /OPT:ICF /INCREMENTAL:NO)
        target_link_libraries(Harmos::Cpp INTERFACE ws2_32 userenv bcrypt ntdll advapi32)
    else()
        target_link_libraries(Harmos::Cpp INTERFACE pthread dl m)
    endif()
endif()
check_required_components(Harmos)
