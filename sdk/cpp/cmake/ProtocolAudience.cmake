# Filter the Pinned Compiler's Public API to Its Declared Audience.
foreach(protocol IN LISTS PROTOCOLS)
    set(header_path "${GENERATED}/${protocol}.grpc.pb.h")
    set(source_path "${GENERATED}/${protocol}.grpc.pb.cc")
    if(protocol MATCHES "^harmos/context/")
        file(REMOVE "${header_path}" "${source_path}")
        continue()
    endif()
    if(AUDIENCE STREQUAL "Host")
        continue()
    endif()
    file(READ "${header_path}" header)
    file(READ "${source_path}" source)
    string(REGEX MATCH "class ([A-Za-z_][A-Za-z0-9_]*) final" declaration "${header}")
    if(NOT declaration)
        continue()
    endif()
    set(service "${CMAKE_MATCH_1}")
    if(AUDIENCE STREQUAL "Plugin")
        string(FIND "${header}" "  class StubInterface" first)
        string(FIND "${header}" "  class Service :" last)
        if(first LESS 0 OR last LESS first)
            message(FATAL_ERROR "Generate ${protocol}: Unsupported Client Declaration Shape")
        endif()
        string(SUBSTRING "${header}" 0 ${first} prefix)
        string(SUBSTRING "${header}" ${last} -1 suffix)
        file(WRITE "${header_path}" "${prefix}${suffix}")
        string(FIND "${source}" "std::unique_ptr< ${service}::Stub> ${service}::NewStub" first)
        string(FIND "${source}" "${service}::Service::Service()" last)
        if(first LESS 0 OR last LESS first)
            message(FATAL_ERROR "Generate ${protocol}: Unsupported Client Definition Shape")
        endif()
        string(SUBSTRING "${source}" 0 ${first} prefix)
        string(SUBSTRING "${source}" ${last} -1 suffix)
        file(WRITE "${source_path}" "${prefix}${suffix}")
    else()
        string(FIND "${header}" "  class Service :" first)
        string(FIND "${header}" "\n};" last REVERSE)
        if(first LESS 0 OR last LESS first)
            message(FATAL_ERROR "Generate ${protocol}: Unsupported Server Declaration Shape")
        endif()
        string(SUBSTRING "${header}" 0 ${first} prefix)
        string(SUBSTRING "${header}" ${last} -1 suffix)
        file(WRITE "${header_path}" "${prefix}${suffix}")
        string(FIND "${source}" "${service}::Service::Service()" first)
        if(first LESS 0)
            message(FATAL_ERROR "Generate ${protocol}: Unsupported Server Definition Shape")
        endif()
        string(SUBSTRING "${source}" ${first} -1 tail)
        string(FIND "${tail}" "\n}  // namespace" last)
        if(last LESS 0)
            message(FATAL_ERROR "Generate ${protocol}: Missing Namespace Boundary")
        endif()
        string(SUBSTRING "${source}" 0 ${first} prefix)
        string(SUBSTRING "${tail}" ${last} -1 suffix)
        file(WRITE "${source_path}" "${prefix}${suffix}")
    endif()
endforeach()
