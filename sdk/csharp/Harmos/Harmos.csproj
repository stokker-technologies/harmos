<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Typed Harmos v1 Plugin SDK</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
    <Protobuf Include="../../../proto/harmos/v1/storage.proto" ProtoRoot="../../../proto" GrpcServices="Client" />
    <Protobuf Include="../../../proto/harmos/v1/plugin.proto" ProtoRoot="../../../proto" GrpcServices="Server" />
  </ItemGroup>
</Project>
