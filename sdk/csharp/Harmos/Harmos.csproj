<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Typed Harmos v1 Plugin SDK</Description>
    <Version>0.1.0</Version>
    <PackageId>Harmos</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
    <Protobuf Include="../../../proto/harmos/v1/types.proto" ProtoRoot="../../../proto" GrpcServices="None" />
    <Protobuf Include="../../../proto/harmos/v1/storage_types.proto" ProtoRoot="../../../proto" GrpcServices="None" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../proto/harmos/plugin/v1/instance.proto" ProtoRoot="../../../proto" GrpcServices="Both" />
    <Protobuf Include="../../../proto/harmos/context/v1/*.proto" ProtoRoot="../../../proto" GrpcServices="None" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../proto/harmos/v1/**/*.proto" Exclude="../../../proto/harmos/v1/types.proto;../../../proto/harmos/v1/guest.proto;../../../proto/harmos/v1/storage_types.proto" ProtoRoot="../../../proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
