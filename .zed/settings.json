{
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path": "stkr",
        "arguments": [
          "project",
          "housekeeping",
          "cargo-run",
          "--target-dir",
          "target-editor",
          "--quiet",
          "--",
          "mise",
          "exec",
          "--",
          "rust-analyzer"
        ]
      }
    },
    "taplo": {
      "settings": {
        "evenBetterToml": {
          "taplo": {
            "configFile": {
              "path": "tools/config/taplo.toml",
              "enabled": true
            }
          }
        }
      }
    }
  }
}
