{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Task branches start from and integrate into dev; build/ keeps Renovate branches in the project branch grammar.
  baseBranchPatterns: ["dev"],
  branchPrefix: "build/renovate-",
  semanticCommits: "enabled",
  semanticCommitType: "build",
  // The mise manager bumps the pinned [tools] versions; mise.lock, Cargo.lock, uv.lock and pnpm-lock.yaml refresh with them.
  lockFileMaintenance: { enabled: true },
}
